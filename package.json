{
  "name": "@askviraj/linter-cli",
  "version": "1.0.2",
  "description": "A linter & formatter CLI for JavaScript, TypeScript, Astro, JSON, JSONC, CSS, HTML, Markdown, YAML, TOML, and more.",
  "keywords": [
    "lint",
    "linter",
    "eslint",
    "cli",
    "command-line",
    "interface",
    "javascript",
    "typescript",
    "astro",
    "json",
    "jsonc",
    "css",
    "html",
    "markdown",
    "yaml",
    "toml"
  ],
  "homepage": "https://github.com/virajp/linter-cli",
  "bugs": {
    "url": "https://github.com/virajp/linter-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virajp/linter-cli.git"
  },
  "license": "MIT",
  "author": {
    "name": "Viraj Patel",
    "email": "askviraj@gmail.com",
    "url": "https://github.com/virajp"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "@askviraj/linter-cli": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build"
  },
  "overrides": {
    "yaml": "2.8.3"
  },
  "dependencies": {
    "@eslint/css": "latest",
    "@eslint/js": "latest",
    "@eslint/json": "latest",
    "@eslint/markdown": "latest",
    "@html-eslint/eslint-plugin": "latest",
    "@poupe/eslint-plugin-tailwindcss": "latest",
    "@typescript-eslint/parser": "latest",
    "astro-eslint-parser": "latest",
    "eslint": "latest",
    "eslint-plugin-astro": "latest",
    "eslint-plugin-toml": "latest",
    "eslint-plugin-yml": "latest",
    "globals": "latest",
    "typescript-eslint": "latest"
  },
  "devDependencies": {
    "@bun-security-scanner/osv": "latest",
    "@types/bun": "latest",
    "sort-package-json": "latest",
    "typescript": "latest"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  }
}
