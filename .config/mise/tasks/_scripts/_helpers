#!/usr/bin/env zsh
#MISE hide=true
# Helper functions for mise tasks
# Source this file in other tasks using: source "${SCRIPT_DIR}/_helpers"

# Color codes
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[0;33m'
readonly RED='\033[0;31m'
readonly BOLD='\033[1m'
readonly NORMAL='\033[0m'

# Print colored section header with new line
print_header() {
  local msg="$1"
  echo -e "${GREEN}${BOLD}${msg}${NORMAL}"
}

# Print colored section header without new line
print_header_wait() {
  local msg="$1"
  echo -en "${GREEN}${BOLD}${msg}${NORMAL}"
}

# Print colored section header without new line
print_wait() {
  local msg="$1"
  echo -en "${YELLOW}${BOLD}${msg}${NORMAL}"
}

# Print empty line
print_newline() {
  echo ""
}

# Print warning (yellow)
print_warn() {
  local msg="$1"
  echo -e "${YELLOW}${BOLD}${msg}${NORMAL}"
}

print_error() {
  local msg="$1"
  echo -e "${RED}${BOLD}${msg}${NORMAL}"
}

# Print a full-width separator line built from the given character
line_sep() {
  local COL
  COL=$(stty size 2> /dev/null | awk '{print $2}') || COL=''
  local line
  printf -v line '%*s' "${COL:-80}" ''
  printf '%s\n' "${line// /$1}"
}

print_success() { echo -e "${GREEN}${BOLD}$1${NORMAL}"; }
print_ok() { echo -e "${GREEN}${BOLD}OK${NORMAL}"; }
print_yellow() { echo -e "${YELLOW}$1${NORMAL}"; }
