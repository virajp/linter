---
interface Props {
  title?: string;
}

const { title = "Hello" } = Astro.props as Props;
const items = ["one", "two"];
---
<html lang="en">
  <head><title>{title}</title></head>
  <body>
    <h1>{title}</h1>
    <ul>
      {items.map(item => <li>{item}</li>)}
    </ul>
    {title && <p class:list={["intro", { active: true }]}>Welcome</p>}
    <script>
      const button = document.querySelector("button");
      button?.addEventListener("click", () => {
        button.textContent = "Clicked";
      });
    </script>
    <button type="button">Click</button>
  </body>
</html>
