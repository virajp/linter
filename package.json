{
  "name": "@askviraj/linter",
  "version": "1.0.5",
  "description": "A linter & formatter CLI for JavaScript, TypeScript, Astro, JSON, JSONC, CSS, HTML, Markdown, YAML, TOML, and more.",
  "keywords": [
    "lint",
    "linter",
    "eslint",
    "cli",
    "command-line",
    "interface",
    "javascript",
    "typescript",
    "astro",
    "json",
    "jsonc",
    "css",
    "html",
    "markdown",
    "yaml",
    "toml"
  ],
  "homepage": "https://github.com/virajp/linter",
  "bugs": {
    "url": "https://github.com/virajp/linter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virajp/linter.git"
  },
  "license": "MIT",
  "author": {
    "name": "Viraj Patel",
    "email": "askviraj@gmail.com",
    "url": "https://github.com/virajp"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./auto": "./dist/auto.js"
  },
  "main": "dist/index.js",
  "bin": {
    "linter": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run build && pnpx vitest run tests/unit",
    "test:all": "pnpm run build && pnpx vitest run tests",
    "test:integration": "pnpm run build && pnpx vitest run tests/integration"
  },
  "dependencies": {
    "@eslint/css": "1.3.0",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.0.0",
    "@eslint/markdown": "8.0.2",
    "@html-eslint/eslint-plugin": "0.62.0",
    "@poupe/eslint-plugin-tailwindcss": "0.3.1",
    "@typescript-eslint/parser": "8.61.1",
    "astro-eslint-parser": "2.0.0",
    "debug": "4.4.3",
    "eslint": "10.5.0",
    "eslint-plugin-astro": "2.0.0",
    "eslint-plugin-toml": "1.4.0",
    "eslint-plugin-yml": "3.4.0",
    "globals": "17.6.0",
    "jsonc-parser": "3.3.1",
    "typescript-eslint": "8.61.1",
    "yaml": "2.9.0",
    "yaml-eslint-parser": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "jiti": "2.7.0",
    "sort-package-json": "4.0.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  }
}
