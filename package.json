{
  "name": "@askviraj/linter",
  "version": "1.1.5",
  "description": "A linter & formatter CLI for JavaScript, TypeScript, Astro, JSON, JSONC, CSS, HTML, Markdown, YAML, TOML, and more.",
  "keywords": [
    "lint",
    "linter",
    "eslint",
    "cli",
    "command-line",
    "interface",
    "javascript",
    "typescript",
    "astro",
    "json",
    "jsonc",
    "css",
    "html",
    "markdown",
    "yaml",
    "toml"
  ],
  "homepage": "https://github.com/virajp/linter",
  "bugs": {
    "url": "https://github.com/virajp/linter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virajp/linter.git"
  },
  "license": "MIT",
  "author": {
    "name": "Viraj Patel",
    "email": "askviraj@gmail.com",
    "url": "https://github.com/virajp"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./auto": "./dist/auto.js"
  },
  "main": "dist/index.js",
  "bin": {
    "linter": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm run build && pnpx vitest run tests/unit",
    "test:all": "pnpm run build && pnpx vitest run tests",
    "test:integration": "pnpm run build && pnpx vitest run tests/integration"
  },
  "dependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@html-eslint/eslint-plugin": "^0.65.0",
    "@poupe/eslint-plugin-tailwindcss": "^0.3.1",
    "@typescript-eslint/parser": "^8.67.0",
    "astro-eslint-parser": "^3.1.0",
    "debug": "^4.4.3",
    "eslint": "^10.9.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-toml": "^1.5.0",
    "eslint-plugin-yml": "^3.8.1",
    "globals": "^17.11.0",
    "jsonc-parser": "^3.3.1",
    "typescript": "^6.0.3 <7.0.0",
    "typescript-eslint": "^8.67.0",
    "yaml": "^2.9.0",
    "yaml-eslint-parser": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "jiti": "2.7.0",
    "sort-package-json": "4.0.0",
    "tsx": "4.23.12",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "bundledDependencies": [
    "@eslint/css",
    "@eslint/js",
    "@eslint/json",
    "@eslint/markdown",
    "@html-eslint/eslint-plugin",
    "@poupe/eslint-plugin-tailwindcss",
    "@typescript-eslint/parser",
    "astro-eslint-parser",
    "debug",
    "eslint",
    "eslint-plugin-astro",
    "eslint-plugin-toml",
    "eslint-plugin-yml",
    "globals",
    "jsonc-parser",
    "typescript",
    "typescript-eslint",
    "yaml",
    "yaml-eslint-parser"
  ]
}
