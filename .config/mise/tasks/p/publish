#!/usr/bin/env zsh
#MISE description="Publish to npm from this machine (fallback; prefer CI/OIDC release)"

#USAGE flag "--dry-run" help="Validate the publish without uploading"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_helpers"

cd $MISE_PROJECT_ROOT

print_header "Checking npm authentication..."
npm whoami

print_header "Running tests..."
mise run p:test

print_header "Building package..."
mise run p:build

if [ "${usage_dry_run:-false}" = "true" ]; then
  print_header "Dry run: validating publish..."
  npm publish --access public --dry-run
  print_header "Dry run complete"
  exit 0
fi

print_header "Publishing to npm registry..."
npm publish --access public

print_header "Publish complete"
