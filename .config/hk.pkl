amends "package://github.com/jdx/hk/releases/download/v1.44.1/hk@1.44.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.44.1/hk@1.44.1#/Builtins.pkl"

// Honor .gitignore
walk_ignore = true

// Exclude list (beyond what's in .gitignore)
// exclude = List("node_modules", "dist", ".turbo", "deploy", ".astro")

local checks = new Mapping<String, Step> {
    // Just checks
    ["No commit on main branch"] = (Builtins.no_commit_to_branch) {
        check = "hk util no-commit-to-branch --branch main"
    }
    ["Check merge conflict"] = Builtins.check_merge_conflict
    ["Detect private key"] = Builtins.detect_private_key
    ["Detect large files"] = (Builtins.check_added_large_files) {
        check = "hk util check-added-large-files --maxkb 1024 {{files}}"
    }
    ["Check symlinks"] = Builtins.check_symlinks
    ["Check for secrets"] = Builtins.gitleaks
    ["Check git local config"] {
        check = "mise run code:git-config"
        fix = "mise run code:git-config --fix"
    }
}

local formatters = new Mapping<String, Step> {
    // Formatters
    ["Empty line at end of file"] = Builtins.newlines
    ["Trailing whitespace"] = Builtins.trailing_whitespace
    ["Format code"] {
        check = "mise run code:format {{files}}"
        fix = "mise run code:format --fix {{files}}"
    }
}

local linters = new Mapping<String, Step> {
    ["Lint code"] {
        glob = List("*.ts", "*.tsx", "*.js", "*.jsx", "*.css", "*.scss", "*.html", "*.json", "*.jsonc", "*.mst", "*.mjs", "*.astro", "*.md", "*.yml", "*.yaml", "*.toml")
        check = "mise run code:lint {{files}}"
        fix = "mise run code:lint --fix {{files}}"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps {
            ...checks
            ...formatters
            ...linters
        }
    }
    ["commit-msg"] {
        steps {
            ["Validate Commit Message"] {
                check = "bunx --bun git-conventional-commits commit-msg-hook --config .config/git-conventional-commits.yaml {{commit_msg_file}}"
            }
        }
    }
    ["fix"] {
        fix = true
        steps {
            ...formatters
            ...linters
        }
    }
    ["check"] {
        fix = false
        steps {
            ...checks
            ...formatters
            ...linters
        }
    }
}
