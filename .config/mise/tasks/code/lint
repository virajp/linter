#!/usr/bin/env zsh
#MISE description="Lint files"

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="apply fixes"
#USAGE arg "[files]" var=#true

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_helpers"

cd $MISE_PROJECT_ROOT

# Convert to bash array:
eval "files=($usage_files)"

print_header "Linting files ..."
# Use as array:
for f in "${files[@]}"; do
  echo "- Processing: $f"
done

[[ "${usage_debug:-false}" == "true" ]] && LOG_LEVEL="--debug" || LOG_LEVEL=""
[[ "${usage_fix:-false}" == "true" ]] && FIX="--fix" || FIX=""
[[ ${#files[@]} -eq 0 ]] && files=("**/*")

# Use the project's pinned eslint (not `pnpx`/dlx): self-linting loads the
# TypeScript config src/eslint.config.ts, which needs the `jiti` peer that a
# dlx sandbox lacks. `tests/` holds intentional violation fixtures, excluded
# here the same way the pre-commit hook excludes them.
pnpm exec eslint \
  --no-config-lookup \
  --config $MISE_PROJECT_ROOT/src/eslint.config.ts \
  --color \
  --pass-on-no-patterns \
  --concurrency "auto" \
  --ignore-pattern "tests/**" \
  ${LOG_LEVEL} \
  ${FIX} \
  ${files[@]}

print_header "Linting done"
