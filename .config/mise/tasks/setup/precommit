#!/usr/bin/env zsh
#MISE description="Update and install pre-commit hooks"
#MISE hide=true

set -e
source "${0%/*}/_helpers"

print_header "Updating pre-commit hooks ..."
pre-commit autoupdate --config .config/pre-commit-config.yaml

print_header "Installing pre-commit ..."
pre-commit install --config .config/pre-commit-config.yaml --all --install-hooks --overwrite
