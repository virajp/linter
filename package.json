{
  "name": "@virajp/linter",
  "version": "1.0.0",
  "description": "A linter & formatter CLI for JavaScript, TypeScript, Astro, JSON, JSONC, CSS, HTML, Markdown, YAML, TOML, and more.",
  "keywords": [
    "lint",
    "linter",
    "eslint",
    "cli",
    "command-line",
    "interface",
    "javascript",
    "typescript",
    "astro",
    "json",
    "jsonc",
    "css",
    "html",
    "markdown",
    "yaml",
    "toml"
  ],
  "homepage": "https://github.com/virajp/linter",
  "bugs": {
    "url": "https://github.com/virajp/linter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virajp/linter.git"
  },
  "license": "MIT",
  "author": {
    "name": "Viraj Patel",
    "email": "askviraj@gmail.com",
    "url": "https://github.com/virajp"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./auto": "./dist/auto.js"
  },
  "main": "dist/index.js",
  "bin": {
    "linter": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "test": "bun test tests/unit",
    "test:all": "bun run build && bun test",
    "test:integration": "bun run build && bun test tests/integration",
    "version": "bun -e \"const fs=require('fs'); const j=JSON.parse(fs.readFileSync('jsr.json','utf8')); j.version=require('./package.json').version; fs.writeFileSync('jsr.json', JSON.stringify(j,null,2)+'\\n');\" && git add jsr.json package.json"
  },
  "dependencies": {
    "@eslint/css": "1.1.0",
    "@eslint/js": "10.0.1",
    "@eslint/json": "1.2.0",
    "@eslint/markdown": "8.0.1",
    "@html-eslint/eslint-plugin": "0.59.0",
    "@poupe/eslint-plugin-tailwindcss": "0.3.1",
    "@typescript-eslint/parser": "8.59.1",
    "astro-eslint-parser": "1.4.0",
    "eslint": "10.2.1",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-toml": "1.3.1",
    "eslint-plugin-yml": "3.3.1",
    "globals": "17.5.0",
    "jsonc-parser": "3.3.1",
    "typescript-eslint": "8.59.1",
    "yaml": "2.8.3",
    "yaml-eslint-parser": "2.0.0"
  },
  "devDependencies": {
    "@bun-security-scanner/osv": "1.0.0",
    "@types/bun": "1.3.13",
    "@types/node": "25.6.0",
    "sort-package-json": "3.6.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  }
}
