#!/usr/bin/env zsh
#MISE description="Setup the project: install precommit hooks, upgrade dependencies, clean up cache, etc."
#MISE depends=["init"]

set -e
source "${0%/*}/_helpers"

# Reshim mise to ensure all tools are available
print_header "Reshimming mise ..."
mise reshim

# Run mise doctor
print_header "Running mise doctor ..."
mise doctor --quiet --silent > /dev/null

# Install & upgrade mise
print_header "Setting up MISE ..."
mise install

print_header "Upgrading mise tools ..."
mise upgrade --local || true

mise run setup:bun:install

mise run setup:precommit

# Setup Kimi
print_header "Setting up Context7 MCP for Kimi ..."
kimi mcp add --transport http context7 https://mcp.context7.com/mcp 2>/dev/null || true

echo "Setup complete!"
