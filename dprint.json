{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "dockerfile": {
    "newLineKind": "lf"
  },
  "excludes": [
    "**/node_modules/",
    "**/dist/",
    "**/build/",
    "**/.astro/",
    "**/.turbo/",
    "**/.github/**/*.md",
    "**/*-lock.json",
    "**/*-lock.yaml"
  ],
  "includes": [
    "**/*.json",
    "**/*.md",
    "**/*.yml",
    "**/*.yaml",
    "**/*.toml",
    "**/dockerfile",
    "**/dockerfile.*"
  ],
  "incremental": false,
  "indentWidth": 2,
  "json": {
    "array.preferSingleLine": false,
    "commentLine.forceSpaceAfterSlashes": true,
    "deno": false,
    "ignoreNodeCommentText": "dprint-ignore",
    "indentWidth": 2,
    "jsonTrailingCommaFiles": [],
    "lineWidth": 120,
    "locked": false,
    "newLineKind": "lf",
    "object.preferSingleLine": false,
    "preferSingleLine": false,
    "trailingCommas": "jsonc",
    "useTabs": false
  },
  "lineWidth": 120,
  "markdown": {
    "emphasisKind": "asterisks",
    "lineWidth": 80,
    "newLineKind": "lf",
    "tags": {
      "json": "json",
      "markdown": "md",
      "text": "text",
      "toml": "toml",
      "typescript": "ts",
      "yaml": "yaml",
      "yml": "yaml"
    },
    "textWrap": "always"
  },
  "markup": {},
  "newLineKind": "lf",
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.21.1.wasm",
    "https://plugins.dprint.dev/toml-0.7.0.wasm",
    "https://plugins.dprint.dev/dockerfile-0.3.3.wasm",
    "https://plugins.dprint.dev/g-plane/markup_fmt-v0.27.0.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
    "https://plugins.dprint.dev/json-0.21.3.wasm",
    "https://plugins.dprint.dev/typescript-0.95.15.wasm"
  ],
  "toml": {
    "newLineKind": "lf"
  },
  "useTabs": false,
  "yaml": {
    "printWidth": 80
  }
}
