#!/usr/bin/env bash
#MISE description="Upgrade dependencies"
#MISE hide=true

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_helpers"

print_header "Updating pnpm in package.json ..."
pnpm self-update $(mise exec -- pnpm --version)

# Resolve in two lockfile-only passes, then materialise node_modules once.
#
#   1. Seed the lockfile. `pnpm update --latest` resolves the `latest` dist-tag
#      even for packages excluded with `!`, ignoring their package.json range --
#      on a clean slate (cleanup deletes the lockfile) that pulls typescript 7,
#      which eslint/typescript-eslint do not support. Given a lockfile that
#      already pins 6.x, the `!typescript` exclusion leaves that resolution alone.
#   2. A `pnpm update` that downloads leaks handles on the store index
#      (~/Library/pnpm/store/v11/index.db) and never exits -- pnpm 11.18.0, only
#      reproducible against a cold store, which `store prune` in cleanup
#      guarantees. `--lockfile-only` downloads nothing, so the install below is
#      the only pass that touches the store.
print_header "Resolving dependencies ..."
pnpm install --lockfile-only

print_header "Updating dependencies to latest ..."
# `!@eslint/css`: hold @eslint/css at 1.x. @poupe/eslint-plugin-tailwindcss
# (latest 0.3.1) needs ^1.1.0; with 2.x ESLint rejects every css/* rule for the
# "tailwindcss/css" language. Drop the exclusion when the plugin supports 2.x.
pnpm --recursive update --latest "!typescript" "!@eslint/css" --lockfile-only

print_header "Install node modules ..."
pnpm install --network-concurrency 10 --recursive
